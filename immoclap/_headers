# En-têtes Netlify — ImmoClap

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Polices : noms de fichiers stables et versionnés, cache d'un an
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Vidéos et images de démonstration : cache de 30 jours
/assets/videos/*
  Cache-Control: public, max-age=2592000
/assets/exemples/*
  Cache-Control: public, max-age=2592000
/assets/*.png
  Cache-Control: public, max-age=2592000
/assets/*.svg
  Cache-Control: public, max-age=2592000
/assets/*.jpg
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000

# Espace client en test : jamais indexé
/app.html
  X-Robots-Tag: noindex, nofollow
/app
  X-Robots-Tag: noindex, nofollow

# Pages utilitaires : non indexées
/merci.html
  X-Robots-Tag: noindex
/404.html
  X-Robots-Tag: noindex
