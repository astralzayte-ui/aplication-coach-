# ---- YouCan Pay ----
# Récupère ces clés dans ton tableau de bord YouCan Pay : Paramètres > Clés API
# NE JAMAIS mettre la clé privée dans le code du navigateur : elle reste ici (serveur).

# Clé PUBLIQUE (peut être exposée au navigateur)
NEXT_PUBLIC_YOUCAN_PUBLIC_KEY=

# Clé PRIVÉE (secrète, serveur uniquement)
YOUCAN_PRIVATE_KEY=

# Mode : "sandbox" pour les tests, "production" quand tu es prêt à encaisser
YOUCAN_MODE=sandbox

# Email où recevoir les nouvelles commandes (facultatif pour plus tard)
ORDER_NOTIFY_EMAIL=
