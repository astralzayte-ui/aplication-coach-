<body data-page="accueil">
<div id="entete"></div>
<main>

  <!-- 1. LA UNE — une grande photo, une phrase, un bouton -->
  <section class="une">
    <a class="une-lien" href="collection.html?c=tout">
      <img class="une-photo" src="img/hoodie-ailes-1.jpg" alt="La mannequin Ambre Noire en hoodie ailes en strass" fetchpriority="high">
      <div class="une-texte">
        <span class="une-sur">Collection hiver</span>
        <h1>Le streetwear,<br>version chic.</h1>
        <span class="une-bouton">Découvrir</span>
      </div>
    </a>
  </section>

  <!-- 2. LES RAYONS — une photo, un mot, un clic -->
  <section class="enveloppe bloc">
    <div class="tuiles" data-tuiles></div>
  </section>

  <!-- 3. TENDANCE — la piste qui glisse -->
  <section class="enveloppe bloc">
    <div class="rangee-titre"><h2>Tendance</h2><a href="collection.html?c=tout">Tout voir</a></div>
    <div class="piste" data-piste></div>
  </section>

  <!-- 4. LA BANDE PROMO -->
  <section class="bande-promo">
    <a href="collection.html?c=accessoires">
      <span class="bande-gros">Le bonnet à 5 €</span>
      <span class="bande-petit">dès 2 articles dans ton panier</span>
      <span class="une-bouton une-bouton-noir">J'en profite</span>
    </a>
  </section>

  <!-- 5. LES PACKS -->
  <section class="enveloppe bloc">
    <div class="rangee-titre"><h2>Les packs</h2><span class="rangee-note">Un prix, un colis</span></div>
    <div class="escalier" data-escalier></div>
  </section>

  <!-- 6. NOUVEAUTÉS — toute la boutique -->
  <section class="enveloppe bloc">
    <div class="rangee-titre"><h2>Nouveautés</h2><a href="collection.html?c=tout">Tout voir</a></div>
    <div class="grille grille-4" data-grille></div>
  </section>

  <!-- 7. INSTAGRAM -->
  <section class="enveloppe bloc insta">
    <p class="insta-sur">Suis-nous sur Insta</p>
    <a class="insta-nom" data-insta-lien href="#" target="_blank" rel="noopener">@ambrenoirparisfr</a>
    <div class="insta-grille" data-insta></div>
  </section>

  <!-- 8. LA RÉASSURANCE -->
  <section class="enveloppe reassurance">
    <div class="reassure"><i data-ico="camion"></i><div><b>Livraison en France</b><span>Suivi envoyé dès le départ</span></div></div>
    <div class="reassure"><i data-ico="carte"></i><div><b>Paiement sécurisé</b><span>Par carte bancaire</span></div></div>
    <div class="reassure"><i data-ico="retour"></i><div><b>Changé d'avis ?</b><span>Remboursé sur ta carte</span></div></div>
    <div class="reassure"><i data-ico="bulle"></i><div><b>Un vrai contact</b><span>Avant comme après</span></div></div>
  </section>

  <!-- 9. LA FAQ -->
  <section class="enveloppe bloc" id="faq">
    <div class="rangee-titre rangee-centre"><h2>Tes questions</h2></div>
    <div class="faq" data-faq></div>
  </section>

</main>
